FROM golang:1.27-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src
COPY zig/ingest/go.mod zig/ingest/go.sum ./
RUN go mod download

COPY zig/ingest/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /ingestd ./cmd/ingestd/

# ─── runtime ─────────────────────────────────────────────────────────────────

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata
RUN adduser -D -u 1000 cairn

COPY --from=builder /ingestd /usr/local/bin/ingestd

RUN mkdir -p /data/bundles && chown cairn:cairn /data/bundles
VOLUME /data/bundles

USER cairn
EXPOSE 8443

ENTRYPOINT ["ingestd"]
