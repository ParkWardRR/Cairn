// Template for local deployment values.
//
//   cp src/secrets.h.example src/secrets.h
//
// Then fill in your own values. secrets.h is gitignored; this template is not,
// so never put real credentials or hostnames in it. config.h includes
// secrets.h automatically when present and falls back to generic defaults when
// it is absent, so the project still builds without this file.
#ifndef CAIRN_SECRETS_H
#define CAIRN_SECRETS_H

// Your 2.4 GHz home network. The ESP32 has no 5 GHz radio, so a 5 GHz-only
// SSID will never be visible to it.
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// Where the ingest server lives. Prefer a DNS name over a literal IP — a DHCP
// lease will move eventually and a hardcoded IP fails silently in the field.
// Note that cairn.local requires mDNS, which the ESP32 resolver does not do.
#define CAIRN_SERVER_HOST "cairn.example.lan"
#define CAIRN_SERVER_PORT 8080

#endif // CAIRN_SECRETS_H
